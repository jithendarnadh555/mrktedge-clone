# Copy this file to .env and fill in your free API keys.

# Free tier: https://finnhub.io/register (60 calls/min free)
FINNHUB_API_KEY=

# Free tier: https://console.groq.com/keys (generous free daily quota)
GROQ_API_KEY=

# Optional: change the model Groq uses (defaults to llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: change the port the server runs on
PORT=3000
